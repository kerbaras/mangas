---
import "../styles/site.css";
import { icon } from "../brand";
import archivo from "../fonts/archivo.woff2?url";

type Props = { title: string; description: string };
const { title, description } = Astro.props;
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1f1e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    {/* Motion mode before first paint, so the page never shifts when the script loads. */}
    <script is:inline>
      document.documentElement.dataset.motion = matchMedia("(prefers-reduced-motion: reduce)")
        .matches
        ? "off"
        : CSS.supports("animation-timeline: view()")
          ? "css"
          : "io";
    </script>
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={icon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <slot />
  </body>
</html>
