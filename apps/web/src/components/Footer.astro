---
import { REPO } from "../brand";

const links = [
  { label: "GitHub", href: REPO },
  { label: "Changelog", href: `${REPO}/blob/main/CHANGELOG.md` },
  { label: "MIT licence", href: `${REPO}/blob/main/LICENSE` },
];
---

<footer class="flex flex-wrap items-center justify-between gap-4 border-t border-stroke pt-6 text-body text-ink-2">
  <span>Mangas, made by Matias Pierobon</span>
  <nav aria-label="Project">
    <ul class="flex gap-5">
      {links.map((l) => (
        <li>
          <a href={l.href} class="hover:text-ink hover:underline">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</footer>
