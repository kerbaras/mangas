---
import { RELEASES } from "../brand";
import HeroWindows from "./HeroWindows.astro";
---

<section id="top" class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title" class="display">Your manga.<br />On your Kindle.</h1>
    <p class="lede">
      Follow series from six sources. Mangas downloads new chapters, cuts long webtoon strips at
      the gaps between panels, and sends EPUB, CBZ or PDF to your e-reader.
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <a id="download" href={RELEASES} class="btn btn-primary flex-col items-start justify-center gap-0 py-2">
        <span id="download-label">Download</span>
        <span id="download-meta" class="text-caption font-normal text-white/85">Free and open source</span>
      </a>
      <a href="#downloads" class="btn btn-ghost">All downloads</a>
    </div>
    <p class="label flex flex-wrap gap-x-3 gap-y-1">
      <span>macOS · Windows · Linux · x64 and arm64</span>
      <span data-version></span>
      <a id="download-alt" href={RELEASES} class="underline hover:text-ink" hidden>Other build</a>
    </p>
  </div>
  <HeroWindows />
</section>

<style>
  .hero {
    display: grid;
    gap: 48px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 96px;
  }

  .copy {
    display: grid;
    gap: 26px;
    justify-items: start;
  }

  .display {
    font-size: clamp(60px, 9vw, 112px);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 5fr 7fr;
      padding-top: 72px;
      padding-bottom: 120px;
    }
  }
</style>
