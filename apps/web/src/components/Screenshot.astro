---
import dark1280 from "../assets/library-dark-1280.webp";
import dark2560 from "../assets/library-dark-2560.webp";
import light1280 from "../assets/library-light-1280.webp";
import light2560 from "../assets/library-light-2560.webp";

// Pre-sized WebP files (the site uses the passthrough image service), light and dark.
const sizes = "(min-width: 1120px) 1040px, calc(100vw - 48px)";
const srcset = (a: ImageMetadata, b: ImageMetadata) => `${a.src} 1280w, ${b.src} 2560w`;
const lightSet = srcset(light1280, light2560);
const darkSet = srcset(dark1280, dark2560);
---

<figure class="overflow-hidden rounded-lg border border-stroke bg-surface shadow-[0_8px_32px_rgb(0_0_0/0.08)]">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={darkSet} sizes={sizes} />
    <img
      src={light1280.src}
      srcset={lightSet}
      sizes={sizes}
      width={light1280.width}
      height={light1280.height}
      alt="The Mangas library: a grid of twelve followed series with their covers and unread-chapter badges."
      fetchpriority="high"
      decoding="async"
      class="block h-auto w-full"
    />
  </picture>
</figure>
