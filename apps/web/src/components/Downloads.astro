---
import { RELEASES } from "../brand";
import type { Target } from "../lib/assets";

type Build = { label: string; target: Target; kind?: string };

// Links start at the releases page; the download script swaps in direct asset URLs.
const platforms: { os: string; builds: Build[] }[] = [
  {
    os: "macOS",
    builds: [
      { label: "Apple silicon", target: "macos-arm64", kind: ".dmg" },
      { label: "Intel", target: "macos-x64", kind: ".dmg" },
    ],
  },
  {
    os: "Windows",
    builds: [
      { label: "x64", target: "windows-x64" },
      { label: "Arm", target: "windows-arm64" },
    ],
  },
  {
    os: "Linux",
    builds: [
      { label: "x64 .AppImage", target: "linux-x64", kind: ".AppImage" },
      { label: "x64 .deb", target: "linux-x64", kind: ".deb" },
      { label: "x64 .rpm", target: "linux-x64", kind: ".rpm" },
      { label: "Arm .AppImage", target: "linux-arm64", kind: ".AppImage" },
      { label: "Arm .deb", target: "linux-arm64", kind: ".deb" },
      { label: "Arm .rpm", target: "linux-arm64", kind: ".rpm" },
    ],
  },
];
---

<section id="downloads" aria-labelledby="downloads-title" class="wrap flex flex-col gap-8 border-t border-stroke py-28">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="downloads-title" class="display text-[56px] sm:text-[72px]">Download</h2>
    <span data-version class="label"></span>
  </div>
  <div class="grid gap-8 sm:grid-cols-3">
    {
      platforms.map((p) => (
        <div class="flex flex-col gap-3 border-t border-stroke pt-5">
          <h3 class="text-subtitle font-semibold">{p.os}</h3>
          <ul class="flex flex-col gap-1.5 text-body-lg text-ink-2">
            {p.builds.map((b) => (
              <li>
                <a
                  href={RELEASES}
                  data-target={b.target}
                  data-kind={b.kind}
                  class="underline hover:text-ink"
                >
                  {b.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="max-w-[70ch] text-body text-ink-2">
    The macOS app isn't notarized yet. Open it once, then go to System Settings → Privacy &amp; Security and click Open Anyway.
  </p>
</section>
