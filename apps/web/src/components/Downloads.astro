---
import { RELEASES } from "../brand";
import type { Target } from "../lib/assets";

type Build = { label: string; target: Target; kind?: string };

// Links start at the releases page; the download script swaps in direct asset URLs.
const platforms: { os: string; builds: Build[] }[] = [
  {
    os: "macOS",
    builds: [
      { label: "Apple silicon", target: "macos-arm64", kind: ".dmg" },
      { label: "Intel", target: "macos-x64", kind: ".dmg" },
    ],
  },
  {
    os: "Windows",
    builds: [
      { label: "x64", target: "windows-x64" },
      { label: "Arm", target: "windows-arm64" },
    ],
  },
  {
    os: "Linux",
    builds: [
      { label: "x64 .AppImage", target: "linux-x64", kind: ".AppImage" },
      { label: "x64 .deb", target: "linux-x64", kind: ".deb" },
      { label: "Arm .AppImage", target: "linux-arm64", kind: ".AppImage" },
      { label: "Arm .deb", target: "linux-arm64", kind: ".deb" },
    ],
  },
];
---

<section id="downloads" aria-labelledby="downloads-title" class="flex flex-col gap-5">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="downloads-title" class="text-subtitle font-semibold">All downloads</h2>
    <span data-version class="text-body text-ink-2"></span>
  </div>
  <div class="grid gap-6 sm:grid-cols-3">
    {
      platforms.map((p) => (
        <div class="flex flex-col gap-2">
          <h3 class="text-body font-semibold">{p.os}</h3>
          <ul class="flex flex-col gap-1 text-body text-ink-2">
            {p.builds.map((b) => (
              <li>
                <a
                  href={RELEASES}
                  data-target={b.target}
                  data-kind={b.kind}
                  class="underline hover:text-ink"
                >
                  {b.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="text-body text-ink-2">
    If macOS says the app can't be opened, right-click it and choose Open.
  </p>
</section>
