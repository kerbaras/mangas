---
import Capabilities from "../components/Capabilities.astro";
import CutBand from "../components/CutBand.astro";
import Downloads from "../components/Downloads.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import SmartCut from "../components/SmartCut.astro";
import Steps from "../components/Steps.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="mangas: a manga library that exports to Kindle"
  description="Desktop app for macOS, Windows and Linux. Follow manga and webtoons, download new chapters, cut long strips into pages and send EPUBs to your Kindle."
>
  <Nav />
  <main>
    <Hero />
    <CutBand />
    <Steps />
    <SmartCut />
    <Capabilities />
    <Downloads />
  </main>
  <Footer />
  <script>
    import "../lib/download";
    import { start } from "../lib/motion";

    start(document);
  </script>
</Base>
