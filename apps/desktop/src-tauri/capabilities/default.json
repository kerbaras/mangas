{
  "$schema": "https://schema.tauri.app/config/capability",
  "identifier": "default",
  "description": "Main window: core IPC, window controls for the custom title bar, file dialogs, the opener plugin and clipboard writes",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default",
    "clipboard-manager:allow-write-text"
  ]
}
